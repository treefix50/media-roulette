# ════════════════════════════════════════════════════════════
# MEDIA ROULETTE ENVIRONMENT CONFIGURATION
# ════════════════════════════════════════════════════════════
# COPY THIS FILE TO .env AND FILL IN THE VALUES
# ⚠️  NEVER COMMIT .env TO GIT REPOSITORY! ⚠️
# ════════════════════════════════════════════════════════════

# GENERATE SECURE KEYS (run this command):
# python -c "import secrets; print(secrets.token_hex(64))"

# ── CRITICAL: MUST CHANGE FOR PRODUCTION ────────────────────
SECRET_KEY=<PASTE_YOUR_GENERATED_SECRET_KEY_HERE>
SECURITY_PASSWORD_SALT=<ANOTHER_GENERATED_KEY_HERE>

# Admin Account Credentials
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=YourSuperSecurePassword123!ChangeThis

# ── Application Settings ────────────────────────────────────
FLASK_ENV=production
SERVER_NAME=media.your-domain.com
URL_SCHEME=https
PORT=8000
LOG_LEVEL=INFO

# ── Database (optional - defaults to SQLite) ────────────────
# DATABASE_URL=sqlite:///state/media_roulette.db

# ── CORS Allowed Origins ────────────────────────────────────
ALLOWED_ORIGINS=https://your-domain.com,http://localhost

# ── Rate Limit Storage ──────────────────────────────────────
RATE_LIMIT_STORAGE=memory://

# ── Trusted Hosts ───────────────────────────────────────────
TRUSTED_HOSTS=*
